# ===== COPIE para .env.local (computador) ou cadastre no Netlify > Site configuration > Environment variables =====
# NUNCA coloque valores reais neste arquivo nem no GitHub.

# --- Públicas (aparecem no navegador; por isso NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço curto da empresa no banco (companies.slug). Hoje: ice
NEXT_PUBLIC_COMPANY_SLUG=ice
# Domínio usado só para montar o e-mail interno dos técnicos (nunca recebe e-mail). Veja PROJETO.md
NEXT_PUBLIC_TECH_EMAIL_DOMAIN=example.com
# Chave PÚBLICA de avisos (gerada pelo arquivo gerar-chaves-push.html)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- SECRETAS (só no servidor; no Netlify marque como "Contains secret values") ---
SUPABASE_SERVICE_ROLE_KEY=
# Chave PRIVADA de avisos (gerada pelo arquivo gerar-chaves-push.html)
VAPID_PRIVATE_KEY=
# E-mail de contato para o serviço de avisos, no formato mailto:seuemail@exemplo.com
VAPID_SUBJECT=
# Senha longa (16+ caracteres) que autoriza o agendador a disparar avisos
CRON_SECRET=

# --- Só para testes/desenvolvimento ---
# PUSH_TRANSPORT=dry-run   (não envia de verdade; só registra)
